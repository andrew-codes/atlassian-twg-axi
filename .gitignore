dist/
*.log

# Yarn Plug'n'Play (zero-installs): keep the cache, PnP loader, and yarn
# release binary committed. Everything else Yarn generates locally is safe
# to ignore.
.yarn/*
!.yarn/cache
!.yarn/releases
!.yarn/patches
!.yarn/plugins
!.yarn/sdks
.yarn/unplugged
.yarn/install-state.gz
.yarn/build-state.yml
.pnp.loader.mjs
node_modules/
